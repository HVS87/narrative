{
  "name": "narrative",
  "productName": "Narrative",
  "version": "1.0.9",
  "description": "Narrative: a free, private tool to build, map and rearrange stories.",
  "author": "Narrative",
  "license": "UNLICENSED",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --publish never"
  },
  "devDependencies": {
    "electron": "33.2.1",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "app.narrative.desktop",
    "productName": "Narrative",
    "copyright": "Narrative",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "offline.html",
      "icon.png",
      "package.json"
    ],
    "win": {
      "icon": "build/icon.png",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Narrative",
      "installerLanguages": [
        "en_US",
        "pt_PT",
        "es_ES",
        "fr_FR"
      ],
      "artifactName": "Narrative-${version}-windows-setup.${ext}"
    },
    "portable": {
      "artifactName": "Narrative-${version}-windows-portable.${ext}"
    },
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "build/icon.png",
      "identity": null,
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "universal"
          ]
        }
      ],
      "artifactName": "Narrative-${version}-mac.${ext}"
    },
    "dmg": {
      "title": "Narrative ${version}"
    },
    "linux": {
      "category": "Office",
      "icon": "build/icon.png",
      "synopsis": "Build, map and rearrange stories",
      "target": [
        "AppImage",
        "tar.gz"
      ],
      "artifactName": "Narrative-${version}-linux-${arch}.${ext}"
    },
    "publish": {
      "provider": "github",
      "owner": "HVS87",
      "repo": "narrative",
      "releaseType": "release"
    }
  },
  "allowScripts": {
    "electron@33.2.1": true
  },
  "homepage": "https://hvs87.github.io/narrative/"
}
